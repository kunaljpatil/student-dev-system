# Application Settings
PROJECT_NAME="AI-Based Student Performance & Development System"
VERSION="1.0.0"
API_PREFIX="/api"
ENV="development"

# Database: SQLite locally, switchable to PostgreSQL via:
# postgresql://user:password@localhost:5432/student_dev_db
DATABASE_URL="sqlite:///./student_dev.db"

# Security & JWT
JWT_SECRET="super-secret-key-change-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo Passwords (for seeding)
DEMO_ADMIN_PASSWORD="Admin@123"
DEMO_TEACHER_PASSWORD="Teach@123"
DEMO_STUDENT_PASSWORD="Study@123"
